_auto_source_venv() {
  declare -a options
  declare root_status=-1
  options=("venv" ".venv")
  for dir in "${options[@]}"; do
    if [[ -d "$dir" ]]; then
      source "$dir"/bin/activate
      return 0
    fi

    if [[ $root_status -eq -1 ]]; then
      root="$(git rev-parse --show-toplevel 2>/dev/null)"
      root_status=$?
    fi

    if [[ $root_status -ne 0 ]]; then
      if command -v deactivate > /dev/null; then
        deactivate
      fi

      continue
    fi

    root_venv="$root/$dir"
    if [[ -d "$root_venv" ]]; then
      source "$root_venv/bin/activate"
    else
      if command -v deactivate > /dev/null; then
        deactivate
      fi
    fi
  done
}

