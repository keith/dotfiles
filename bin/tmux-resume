#!/bin/bash

set -euo pipefail
set -x
exec 2> /tmp/tmux-resume

# The bindings pass the pane from the "#{pane_id}" format since run-shell
# commands don't get $TMUX_PANE
pane_id=$1
shift

env_line=$(tmux show-environment "TMUXPWD_${pane_id#\%}" || true)
new_pwd=${env_line#*=}
if [[ -z "$new_pwd" || ! -d "$new_pwd" ]];then
  if [[ -f "${CURRENT_PROJECT_PATH:-}" ]]; then
    new_pwd="$(cat "$CURRENT_PROJECT_PATH")"
  else
    new_pwd="$HOME"
  fi
fi

# TODO the $2 isn't set for new-window because it's used for -h/-v
tmux "$1" ${2:-} -c "$new_pwd"
