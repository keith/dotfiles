#!/bin/bash

set -euo pipefail
set -x

checkout_root="$PWD"
while [[ ! -f "$checkout_root/swift/utils/build-script" ]]; do
  if [[ "$checkout_root" == / ]]; then
    echo "Could not find swift/utils/build-script in this directory or its ancestors" >&2
    exit 1
  fi
  checkout_root="$(dirname "$checkout_root")"
done
cd "$checkout_root"

args=(
  --build-subdir .
  --enable-experimental-string-processing
  --reconfigure
  --release-debuginfo
  --skip-build-benchmarks
  --swift-disable-dead-stripping
)

if command -v sccache >/dev/null; then
  args+=(--sccache)
else
  args+=(--sccache false)
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  args+=(
    --llvm-targets-to-build "AArch64;ARM;X86"
    --skip-tvos
    --skip-watchos
    --swift-darwin-supported-archs "arm64;x86_64"
  )
fi

DEVELOPER_DIR=/Applications/Xcode-26.5.0-RC1.app/Contents/Developer \
 ./swift/utils/build-script \
 "${args[@]}" \
 "$@"
