#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: tmux-agent <command> <resume-argument> [-r] <directory>" >&2
  exit 1
}

if [[ $# -lt 2 ]]; then
  usage
fi

agent_command="$1"
resume_argument="$2"
shift 2

resume_flag=""
while getopts "r" opt; do
  case "$opt" in
    r) resume_flag="$resume_argument" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -ne 1 ]]; then
  usage
fi

dir="$(cd "$1" > /dev/null 2>&1 && pwd)" || true
unset CDPATH
if [[ -z "$dir" || ! -d "$dir" ]]; then
  echo "tmux-agent: no such directory: $1" >&2
  exit 1
fi

tmux new-window -c "$dir" "${agent_command}${resume_flag:+ $resume_flag}"
tmux split-window -h -c "$dir"
tmux select-pane -L
