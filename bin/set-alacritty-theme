#!/bin/bash

set -euo pipefail

theme=$(get-appearance)
config_path=$HOME/.config/alacritty/alacritty.toml
if [[ $theme == light ]]; then
  old_theme=dark
else
  old_theme=light
fi

if [[ $(< "$config_path") != *"config/alacritty/solarized_$old_theme"* ]]; then
  exit 0
fi

perl -i -pe \
  's=config/alacritty/solarized_(light|dark)=config/alacritty/solarized_'"$theme"'=' \
  "$config_path"
